    Sidebar      = color(0.03, 0.03, 0.035, 0.9),
    Card         = color(0.07, 0.07, 0.08, 0.92),
    CardGlass    = color(1, 1, 1, 0.05),
    Border       = color(1, 1, 1, 0.10),
    BorderBright = color(1, 1, 1, 0.22),

    Text     = color():hex(0xF5F6F8),
    TextDim  = color():hex(0xA8ACB6),
    TextFaint= color(1, 1, 1, 0.45),

    Accent    = color():hex(0x9BBCFF),
    AccentDim = color(0.608, 0.737, 1.0, 0.16),
    AccentSoft= color(0.608, 0.737, 1.0, 0.06),

    Danger  = color(1, 0.38, 0.42, 1),
    Success = color(0.45, 0.9, 0.55, 1),
    Warning = color(1, 0.76, 0.35, 1),

