--[[
    ========================================================================
    Light — animated custom-rendered UI library for Photon
    Black background / #9bbcff accent
    ========================================================================

    Goals of this build, vs. earlier NovaUI:
      • Real easing (not just exponential lerp) via an `Ease` module
      • Ripple-on-click feedback for buttons/toggles
      • Springy open/close animation for the whole window
      • Tab-switch content fades + slides rather than an instant swap
      • Full HSV color picker panel (saturation/value square + hue strip)
      • Text input boxes with a blinking caret
      • Multi-select checklist dropdowns
      • Toast notification stack with slide-in/out
      • Tooltips with fade
      • Config save/load via file.write/file.read (JSON-ish, matches the
        pattern used elsewhere in this project)

    Structure of this file:
      1.  Easing module
      2.  Theme
      3.  Small math/color/rect helpers
      4.  Key name table (for keybind display)
      5.  Element constructors (toggle, slider, button, dropdown,
          multiselect, input, keybind, colorpicker, label, divider,
          progress)
      6.  Section / Tab / Window object model
      7.  Notification + tooltip subsystems
      8.  Config save/load
      9.  The single render hook that draws + handles input for
          everything above
      10. Public `Light` table returned at the bottom
]]

-- ========================================================================
-- 1. EASING MODULE
-- ========================================================================
-- Small collection of standard easing curves, all operating on t in [0,1].
-- Used anywhere we want motion to feel less linear than a raw lerp.

local Ease = {}

function Ease.linear(t) return t end

function Ease.out_quad(t) return 1 - (1 - t) * (1 - t) end

function Ease.in_quad(t) return t * t end

function Ease.out_cubic(t) local f = 1 - t; return 1 - f * f * f end

function Ease.in_out_cubic(t)
    if t < 0.5 then return 4 * t * t * t end
    local f = -2 * t + 2
    return 1 - (f * f * f) / 2
end

function Ease.out_back(t)
    local c1 = 1.70158
    local c3 = c1 + 1
    local f = t - 1
    return 1 + c3 * f * f * f + c1 * f * f
end

function Ease.out_elastic(t)
    if t == 0 then return 0 end
    if t == 1 then return 1 end
    local c4 = (2 * math.pi) / 3
    return 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * c4) + 1
end

-- Exponential "approach" — frame-rate independent, used for continuous
-- follow-the-mouse style animations (sliders, hover glow) rather than
-- fixed-duration tweens.
local function approach(current, target, speed, dt)
    return current + (target - current) * math.min(speed * dt, 1)
end

-- Fixed-duration tween helper: given a table with `t` (0..1) and a speed,
-- advances `t` by dt*speed and returns the eased value via `curve`.
local function tween_step(state, dt, speed, curve)
    state.t = math.min(1, state.t + dt * speed)
    return (curve or Ease.out_cubic)(state.t)
end

